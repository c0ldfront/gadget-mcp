# gadget-mcp environment variables
# -----------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and tune per deployment. Bun auto-loads `.env`
# when launching scripts from this directory; no dotenv package is needed.

# ---- Storage ---------------------------------------------------------------

# Default SQLite path when GADGET_WORKSPACES is not set.
GADGET_DB=./artifacts/gadget.db

# Multi-workspace isolation. JSON object mapping workspace name to DB path.
# Names must match ^[a-z0-9][a-z0-9._-]{0,63}$.
# Leave empty for a single "default" workspace at $GADGET_DB.
# GADGET_WORKSPACES={"team-a":"/var/lib/gadget/a.db","team-b":"/var/lib/gadget/b.db"}

# ---- Transport: stdio ------------------------------------------------------

# Stdio is trusted — no knobs. Launch with `gadget-mcp --stdio`.

# ---- Transport: Streamable HTTP --------------------------------------------

GADGET_HTTP_HOST=127.0.0.1
GADGET_HTTP_PORT=7878

# Bearer-token RBAC. CSV of "token:role" pairs where role is one of
# reader | writer | admin. Empty value disables auth and treats every caller
# as admin (local development only — NEVER in production).
# GADGET_HTTP_TOKENS=ops:admin,app:writer,dashboards:reader

# Strict-equality Origin allowlist (CSV). Empty = no Origin check.
# GADGET_ORIGIN_ALLOWLIST=https://claude.ai,http://localhost:3000

# Host header allowlist (CSV) — DNS-rebinding mitigation. Port suffixes ok.
# GADGET_HTTP_ALLOWED_HOSTS=gadget.example.com,gadget.example.com:7878

# Max /mcp request body in bytes (default 10 MiB).
# GADGET_HTTP_MAX_BODY_BYTES=10485760

# ---- Seeding ---------------------------------------------------------------

# 'auto' (default) seeds gadgets + reviewer runners from data/ on startup.
# 'off' skips seeding (useful in tests).
GADGET_SEED=auto

# ---- Audit -----------------------------------------------------------------

# Audit log retention in days. Pruning runs on startup.
GADGET_AUDIT_DAYS=90
